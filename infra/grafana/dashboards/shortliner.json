{
  "title": "Shortliner",
  "uid": "shortliner",
  "tags": [
    "shortliner",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pods up",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (container) (up{namespace=\"shortliner\", container=~\"$service\"})",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests / s",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (container) (rate(http_server_requests_seconds_count{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (container) (rate(http_server_requests_seconds_count{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) / sum by (container) (rate(http_server_requests_seconds_count{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (container, le) (rate(http_server_requests_seconds_bucket{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP by endpoint",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests / s by endpoint",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (container, method, uri, status) (rate(http_server_requests_seconds_count{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{container}} {{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by endpoint",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (container, method, uri, le) (rate(http_server_requests_seconds_bucket{namespace=\"shortliner\", container=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{container}} {{method}} {{uri}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "JVM",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap used / max",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
