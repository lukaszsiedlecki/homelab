{
  "title": "Shortliner",
  "uid": "shortliner",
  "tags": [
    "shortliner",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
