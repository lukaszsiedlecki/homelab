            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (pod) (hikaricp_connections_active{namespace=\"shortliner\", container=~\"$service\"})",
          "legendFormat": "{{pod}} active"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "B",
          "expr": "sum by (pod) (hikaricp_connections_pending{namespace=\"shortliner\", container=~\"$service\"})",
