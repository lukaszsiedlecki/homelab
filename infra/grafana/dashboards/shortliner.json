          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "B",
          "expr": "sum(rate(payment_reconciliation_resolved_total{namespace=\"shortliner\"}[$__rate_interval]))",
          "legendFormat": "reconciliation resolved"
        }
      ]
