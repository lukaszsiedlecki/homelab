        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "B",
          "expr": "sum by (pod) (jvm_memory_max_bytes{namespace=\"shortliner\", container=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{pod}} max"
        }
