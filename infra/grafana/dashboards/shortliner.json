      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (pod) (rate(jvm_gc_pause_seconds_sum{namespace=\"shortliner\", container=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "process_cpu_usage{namespace=\"shortliner\", container=~\"$service\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Database (HikariCP)",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
