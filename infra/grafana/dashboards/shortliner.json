        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (pod) (jvm_memory_used_bytes{namespace=\"shortliner\", container=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{pod}} used"
