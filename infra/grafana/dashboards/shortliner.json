      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum(rate(click_events_received_total{namespace=\"shortliner\"}[$__rate_interval]))",
