    {
      "type": "row",
      "title": "Logs",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "id": 21,
      "datasource": {
        "type": "loki",
        "uid": "loki-k8s"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-k8s"
          },
          "refId": "A",
          "expr": "sum by (app, level) (count_over_time({namespace=\"shortliner\", app=~\"$service\"} [$__auto]))",
          "legendFormat": "{{app}} {{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs",
      "id": 22,
      "datasource": {
        "type": "loki",
        "uid": "loki-k8s"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-k8s"
          },
          "refId": "A",
          "expr": "{namespace=\"shortliner\", app=~\"$service\"} |~ \"$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-k8s"
        },
        "query": {
          "query": "label_values(up{namespace=\"shortliner\"}, container)",
          "refId": "service"
        },
        "definition": "label_values(up{namespace=\"shortliner\"}, container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Log search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}