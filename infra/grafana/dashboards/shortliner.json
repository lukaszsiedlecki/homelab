      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
