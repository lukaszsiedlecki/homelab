    {
      "type": "timeseries",
      "title": "Connection acquire time (avg)",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "refId": "A",
          "expr": "sum by (pod) (rate(hikaricp_connections_acquire_seconds_sum{namespace=\"shortliner\", container=~\"$service\"}[$__rate_interval])) / sum by (pod) (rate(hikaricp_connections_acquire_seconds_count{namespace=\"shortliner\", container=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
