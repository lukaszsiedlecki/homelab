{
  "title": "English Teacher: AI",
  "uid": "english-teacher-ai",
  "description": "Every AI call of english-teacher: cost, latency, failures, prompt versions and their logs.",
  "tags": [
    "english-teacher",
    "ai",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "operation",
        "label": "Operation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-k8s"
        },
        "query": {
          "query": "label_values(english_teacher_ai_call_seconds_count, operation)",
          "refId": "operation"
        },
        "definition": "label_values(english_teacher_ai_call_seconds_count, operation)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "prompt",
        "label": "Prompt version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-k8s"
        },
        "query": {
          "query": "label_values(english_teacher_ai_call_seconds_count{operation=~\"$operation\"}, prompt)",
          "refId": "prompt"
        },
        "definition": "label_values(english_teacher_ai_call_seconds_count{operation=~\"$operation\"}, prompt)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "trace",
        "label": "Trace",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "New prompt version",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "english-teacher-db"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "english-teacher-db"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT min(created_at) AS time, 'New prompt version: ' || prompt AS text, operation AS tags FROM ai_usage WHERE prompt IS NOT NULL GROUP BY prompt, operation HAVING min(created_at) BETWEEN $__timeFrom() AND $__timeTo()"
        }
      }
    ]
  },
