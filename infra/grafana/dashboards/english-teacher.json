    {
      "type": "table",
      "title": "Prompt versions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "english-teacher-db"
      },
      "description": "Every prompt version seen in the range: when it first and last answered, how big its answers are, what it cost.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "english-teacher-db"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT prompt AS \"Prompt\", operation AS \"Operation\", min(created_at) AS \"First seen\", max(created_at) AS \"Last seen\", count(*) AS \"Calls\", round(avg(input_tokens)) AS \"Avg input tokens\", round(avg(output_tokens)) AS \"Avg output tokens\", sum(cost_usd) AS \"Cost\", sum(cost_usd) / count(*) AS \"Cost per call\" FROM ai_usage WHERE $__timeFilter(created_at) AND prompt IS NOT NULL AND operation IN (${operation:sqlstring}) AND COALESCE(prompt, 'none') IN (${prompt:sqlstring}) GROUP BY 1, 2 ORDER BY 2, 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost per call"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 5
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "First seen|Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
