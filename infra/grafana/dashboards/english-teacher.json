    {
      "type": "timeseries",
      "title": "Cost per day by provider",
      "description": "From Postgres (ai_usage), so it reaches back further than Prometheus. Set the range to 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "english-teacher-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "english-teacher-db"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'Europe/Warsaw') AT TIME ZONE 'Europe/Warsaw' AS time, CASE WHEN operation = 'transcribe' THEN 'elevenlabs' WHEN operation IN ('speech', 'image') THEN 'openai' ELSE 'anthropic' END AS metric, sum(cost_usd) AS cost FROM ai_usage WHERE $__timeFilter(created_at) AND operation IN (${operation:sqlstring}) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
